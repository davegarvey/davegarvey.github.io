# frozen_string_literal: true
require 'nokogiri'
path = ARGV.fetch(0, '_site/feed.xml')
doc = Nokogiri::XML(File.read(path)) { |config| config.strict }
# Keep the feed identifier used before migration. Article identifiers come from
# each post's feed_id front matter and must not be rewritten here.
feed_id = doc.at_xpath('/atom:feed/atom:id', 'atom' => 'http://www.w3.org/2005/Atom')
feed_id.content = feed_id.content.sub('https://davidgarvey.blog', 'https://davegarvey.github.io') if feed_id
File.write(path, doc.to_xml)
